<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Аккорды из аудио</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#14161c;
    --panel:#1d2029;
    --panel-2:#242834;
    --line:#2f3441;
    --ink:#e8e6e1;
    --muted:#8a8f9c;
    --amber:#e8a33d;      /* мажор — тёплый ламповый свет */
    --teal:#5fb3b3;       /* минор — холодный */
    --amber-dim:rgba(232,163,61,.14);
    --teal-dim:rgba(95,179,179,.14);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:"Space Grotesk",system-ui,sans-serif;
    line-height:1.5;
    min-height:100vh;
    padding:clamp(20px,5vw,64px) 20px 80px;
  }
  .wrap{max-width:820px;margin:0 auto}

  header{margin-bottom:40px}
  .eyebrow{
    font-family:"IBM Plex Mono",monospace;
    font-size:12px;letter-spacing:.28em;text-transform:uppercase;
    color:var(--amber);margin-bottom:14px;
  }
  h1{font-size:clamp(32px,6vw,52px);font-weight:700;letter-spacing:-.02em;line-height:1.05}
  h1 .cool{color:var(--teal)}
  .sub{color:var(--muted);margin-top:14px;max-width:52ch;font-size:15px}

  /* --- Зона загрузки --- */
  .drop{
    margin-top:36px;
    border:1.5px dashed var(--line);
    border-radius:16px;
    background:var(--panel);
    padding:48px 28px;
    text-align:center;
    cursor:pointer;
    transition:border-color .18s, background .18s;
  }
  .drop:hover,.drop.over{border-color:var(--amber);background:var(--panel-2)}
  .drop.over{box-shadow:0 0 0 4px var(--amber-dim)}
  .drop-icon{
    width:46px;height:46px;margin:0 auto 16px;
    border-radius:50%;border:2px solid var(--amber);
    display:grid;place-items:center;color:var(--amber);font-size:22px;
  }
  .drop b{font-weight:500}
  .drop small{display:block;color:var(--muted);margin-top:8px;font-size:13px;
    font-family:"IBM Plex Mono",monospace}
  input[type=file]{display:none}

  /* --- Статус / прогресс --- */
  .status{margin-top:26px;display:none}
  .status.on{display:block}
  .bar{height:6px;background:var(--panel-2);border-radius:99px;overflow:hidden}
  .bar > i{display:block;height:100%;width:0;background:var(--amber);
    transition:width .12s linear}
  .status p{font-family:"IBM Plex Mono",monospace;font-size:13px;color:var(--muted);
    margin-top:10px}

  /* --- Результаты --- */
  .results{margin-top:40px;display:none}
  .results.on{display:block}

  .readout{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:28px}
  .stat{
    flex:1;min-width:130px;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;padding:16px 18px;
  }
  .stat .k{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.18em;
    text-transform:uppercase;color:var(--muted)}
  .stat .v{font-size:26px;font-weight:700;margin-top:6px}
  .stat .v small{font-size:13px;color:var(--muted);font-weight:400;margin-left:4px}

  .section-label{
    font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.2em;
    text-transform:uppercase;color:var(--muted);margin:0 0 12px;
  }

  /* Сигнатура: полоса аккордов во времени, ширина = длительность */
  .timeline{
    display:flex;width:100%;height:56px;border-radius:10px;overflow:hidden;
    border:1px solid var(--line);margin-bottom:32px;background:var(--panel);
  }
  .seg{
    display:grid;place-items:center;font-family:"IBM Plex Mono",monospace;
    font-size:13px;font-weight:600;color:#14161c;min-width:2px;
    border-right:1px solid rgba(20,22,28,.35);overflow:hidden;white-space:nowrap;
  }
  .seg:last-child{border-right:none}
  .seg.maj{background:var(--amber)}
  .seg.min{background:var(--teal)}

  /* Подробный список */
  table{width:100%;border-collapse:collapse;font-family:"IBM Plex Mono",monospace;font-size:14px}
  th{text-align:left;color:var(--muted);font-weight:500;font-size:11px;letter-spacing:.14em;
    text-transform:uppercase;padding:0 12px 10px}
  td{padding:9px 12px;border-top:1px solid var(--line)}
  tr td:first-child{color:var(--muted)}
  .pill{display:inline-block;padding:2px 10px;border-radius:6px;font-weight:600}
  .pill.maj{background:var(--amber-dim);color:var(--amber)}
  .pill.min{background:var(--teal-dim);color:var(--teal)}

  .strum{
    margin-top:32px;background:var(--panel);border:1px solid var(--line);
    border-radius:12px;padding:22px 24px;
  }
  .strum h3{font-size:16px;font-weight:500;margin-bottom:6px}
  .strum .pattern{font-family:"IBM Plex Mono",monospace;font-size:22px;letter-spacing:.15em;
    color:var(--amber);margin:12px 0}
  .strum p{color:var(--muted);font-size:13px}

  .note{margin-top:26px;color:var(--muted);font-size:13px;line-height:1.6}
  .again{
    margin-top:30px;background:none;border:1px solid var(--line);color:var(--ink);
    font-family:"IBM Plex Mono",monospace;font-size:13px;padding:11px 20px;border-radius:9px;
    cursor:pointer;transition:border-color .18s}
  .again:hover{border-color:var(--amber)}

  footer{margin-top:56px;color:var(--muted);font-size:12px;
    font-family:"IBM Plex Mono",monospace;border-top:1px solid var(--line);padding-top:18px}

  @media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="eyebrow">аудио → аккорды</div>
    <h1>Аккорды для <span class="cool">гитары</span><br>из любого трека.</h1>
    <p class="sub">Загрузи аудиофайл — сайт разберёт его прямо в браузере и покажет
    аккорды с таймкодами, темп и подходящий бой. Ничего никуда не отправляется.</p>
  </header>

  <label class="drop" id="drop">
    <div class="drop-icon">↑</div>
    <b>Перетащи файл сюда или нажми, чтобы выбрать</b>
    <small>mp3 · wav · m4a · ogg · flac</small>
    <input type="file" id="file" accept="audio/*">
  </label>

  <div class="status" id="status">
    <div class="bar"><i id="barfill"></i></div>
    <p id="statustext">Читаю файл…</p>
  </div>

  <div class="results" id="results">
    <div class="readout">
      <div class="stat"><div class="k">Темп</div><div class="v" id="bpm">—<small>BPM</small></div></div>
      <div class="stat"><div class="k">Тональность</div><div class="v" id="key">—</div></div>
      <div class="stat"><div class="k">Длительность</div><div class="v" id="dur">—<small>сек</small></div></div>
    </div>

    <div class="section-label">Аккорды во времени</div>
    <div class="timeline" id="timeline"></div>

    <div class="section-label">Подробно</div>
    <table>
      <thead><tr><th>Время</th><th>Аккорд</th></tr></thead>
      <tbody id="tablebody"></tbody>
    </table>

    <div class="strum">
      <h3>Бой</h3>
      <div class="pattern" id="strumpattern">—</div>
      <p id="strumnote"></p>
    </div>

    <p class="note">Точность зависит от записи: чистая акустика распознаётся хорошо,
    плотный микс с искажениями — хуже. Бой подобран по темпу, а не «услышан» —
    точный гитарный штрих из готового микса надёжно не извлекается.</p>

    <button class="again" id="again">← Разобрать другой файл</button>
  </div>

  <footer>Работает офлайн в браузере · Web Audio API + FFT</footer>
</div>

<script>
const NAMES=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const FFT_SIZE=16384, HOP=8192;

// ---------- FFT (радикс-2, на месте) ----------
function fft(re,im){
  const n=re.length;
  for(let i=1,j=0;i<n;i++){let bit=n>>1;for(;j&bit;bit>>=1)j^=bit;j^=bit;
    if(i<j){let tr=re[i];re[i]=re[j];re[j]=tr;let ti=im[i];im[i]=im[j];im[j]=ti;}}
  for(let len=2;len<=n;len<<=1){const ang=-2*Math.PI/len,wr=Math.cos(ang),wi=Math.sin(ang);
    for(let i=0;i<n;i+=len){let cwr=1,cwi=0;
      for(let k=0;k<len/2;k++){const ur=re[i+k],ui=im[i+k];
        const vr=re[i+k+len/2]*cwr-im[i+k+len/2]*cwi, vi=re[i+k+len/2]*cwi+im[i+k+len/2]*cwr;
        re[i+k]=ur+vr;im[i+k]=ui+vi;re[i+k+len/2]=ur-vr;im[i+k+len/2]=ui-vi;
        const n2=cwr*wr-cwi*wi;cwi=cwr*wi+cwi*wr;cwr=n2;}}}
}

// ---------- Шаблоны аккордов ----------
const TEMPLATES=[];
for(let r=0;r<12;r++){
  for(const q of ['maj','min']){
    const v=new Array(12).fill(0);
    const iv = q==='maj'?[0,4,7]:[0,3,7];
    iv.forEach(x=>v[(r+x)%12]=1);
    const norm=Math.sqrt(iv.length);
    TEMPLATES.push({label:NAMES[r]+(q==='maj'?'':'m'),q,vec:v.map(x=>x/norm)});
  }
}

// Окно Ханна, посчитаем один раз
const WINDOW=new Float32Array(FFT_SIZE);
for(let i=0;i<FFT_SIZE;i++) WINDOW[i]=0.5-0.5*Math.cos(2*Math.PI*i/(FFT_SIZE-1));

// ---------- UI ----------
const drop=document.getElementById('drop'), fileInput=document.getElementById('file');
const statusEl=document.getElementById('status'), barfill=document.getElementById('barfill');
const statustext=document.getElementById('statustext'), resultsEl=document.getElementById('results');

['dragover','dragenter'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();drop.classList.add('over');}));
['dragleave','drop'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();drop.classList.remove('over');}));
drop.addEventListener('drop',ev=>{if(ev.dataTransfer.files[0])handleFile(ev.dataTransfer.files[0]);});
fileInput.addEventListener('change',e=>{if(e.target.files[0])handleFile(e.target.files[0]);});
document.getElementById('again').addEventListener('click',()=>{
  resultsEl.classList.remove('on');drop.style.display='';fileInput.value='';window.scrollTo({top:0,behavior:'smooth'});
});

const sleep=ms=>new Promise(r=>setTimeout(r,ms));
function setStatus(t,p){statustext.textContent=t;if(p!=null)barfill.style.width=(p*100)+'%';}

async function handleFile(file){
  drop.style.display='none';resultsEl.classList.remove('on');
  statusEl.classList.add('on');setStatus('Читаю файл…',0.05);
  try{
    const buf=await file.arrayBuffer();
    setStatus('Декодирую аудио…',0.12);
    const ac=new (window.AudioContext||window.webkitAudioContext)();
    const audio=await ac.decodeAudioData(buf);
    await analyze(audio);
  }catch(err){
    setStatus('Не удалось прочитать этот файл. Попробуй другой формат (mp3/wav).',0);
    console.error(err);
    setTimeout(()=>{statusEl.classList.remove('on');drop.style.display='';},2600);
  }
}

async function analyze(audio){
  const sr=audio.sampleRate;
  // моно
  const L=audio.getChannelData(0);
  const R=audio.numberOfChannels>1?audio.getChannelData(1):null;
  const N=L.length; const mono=new Float32Array(N);
  for(let i=0;i<N;i++) mono[i]=R?(L[i]+R[i])*0.5:L[i];
  const duration=N/sr;

  const frames=[]; // {time, chroma[12], energy}
  const re=new Float32Array(FFT_SIZE), im=new Float32Array(FFT_SIZE);
  const totalFrames=Math.max(1,Math.floor((N-FFT_SIZE)/HOP));
  let done=0;

  for(let start=0; start+FFT_SIZE<=N; start+=HOP){
    for(let i=0;i<FFT_SIZE;i++){re[i]=mono[start+i]*WINDOW[i];im[i]=0;}
    fft(re,im);
    const chroma=new Float32Array(12); let energy=0;
    for(let k=1;k<FFT_SIZE/2;k++){
      const f=k*sr/FFT_SIZE; if(f<55||f>2000)continue;
      const mag=Math.hypot(re[k],im[k]);
      energy+=mag;
      const pc=((Math.round(69+12*Math.log2(f/440))%12)+12)%12;
      chroma[pc]+=mag;
    }
    frames.push({time:start/sr, chroma, energy});
    done++;
    if(done%24===0){setStatus('Распознаю аккорды…',0.15+0.7*(done/totalFrames));await sleep(0);}
  }

  // порог тишины
  const energies=frames.map(f=>f.energy).sort((a,b)=>a-b);
  const median=energies[Math.floor(energies.length/2)]||0;
  const silence=median*0.25;

  // на каждый фрейм — лучший аккорд
  let labels=frames.map(f=>{
    if(f.energy<silence) return 'N';
    let norm=0; for(const c of f.chroma) norm+=c*c; norm=Math.sqrt(norm)||1;
    let best='N',bs=-1;
    for(const t of TEMPLATES){
      let dot=0; for(let i=0;i<12;i++) dot+=(f.chroma[i]/norm)*t.vec[i];
      if(dot>bs){bs=dot;best=t.label;}
    }
    return best;
  });

  // сглаживание модой по окну 5
  labels=modeFilter(labels,5);

  // слияние соседних одинаковых в сегменты
  let segs=[];
  for(let i=0;i<labels.length;i++){
    const t=frames[i].time;
    if(segs.length && segs[segs.length-1].label===labels[i]) segs[segs.length-1].end=t;
    else segs.push({label:labels[i],start:t,end:t});
  }
  if(segs.length) segs[segs.length-1].end=duration;
  for(let i=0;i<segs.length-1;i++) segs[i].end=segs[i+1].start;

  // выкидываем слишком короткие (<0.4с) и не-аккорды, сливаем соседей
  segs=segs.filter(s=>s.label!=='N' && (s.end-s.start)>=0.4);
  segs=mergeAdjacent(segs);

  const bpm=estimateTempo(mono,sr);
  const keyLabel=estimateKey(frames);

  setStatus('Готово',1);
  await sleep(120);
  render(segs,bpm,keyLabel,duration);
}

function modeFilter(arr,win){
  const half=win>>1, out=arr.slice();
  for(let i=0;i<arr.length;i++){
    const cnt={};
    for(let j=Math.max(0,i-half);j<=Math.min(arr.length-1,i+half);j++) cnt[arr[j]]=(cnt[arr[j]]||0)+1;
    let best=arr[i],bc=-1; for(const k in cnt) if(cnt[k]>bc){bc=cnt[k];best=k;}
    out[i]=best;
  }
  return out;
}
function mergeAdjacent(segs){
  const out=[];
  for(const s of segs){
    if(out.length && out[out.length-1].label===s.label) out[out.length-1].end=s.end;
    else out.push({...s});
  }
  return out;
}

// Темп: огибающая энергии → автокорреляция
function estimateTempo(mono,sr){
  const hop=Math.round(sr*0.01); // 10мс
  const env=[];
  for(let i=0;i+hop<mono.length;i+=hop){
    let e=0; for(let j=0;j<hop;j++) e+=Math.abs(mono[i+j]); env.push(e);
  }
  // onset = положительная разность
  const flux=[]; for(let i=1;i<env.length;i++) flux.push(Math.max(0,env[i]-env[i-1]));
  const fps=sr/hop;
  let bestBpm=0,bestVal=-1;
  for(let bpm=60;bpm<=180;bpm++){
    const lag=Math.round(fps*60/bpm); if(lag<1||lag>=flux.length)continue;
    let s=0; for(let i=lag;i<flux.length;i++) s+=flux[i]*flux[i-lag];
    if(s>bestVal){bestVal=s;bestBpm=bpm;}
  }
  return bestBpm;
}

// Грубая тональность по суммарной хроме (профиль Краумхансла)
function estimateKey(frames){
  const total=new Float32Array(12);
  for(const f of frames) for(let i=0;i<12;i++) total[i]+=f.chroma[i];
  const maj=[6.35,2.23,3.48,2.33,4.38,4.09,2.52,5.19,2.39,3.66,2.29,2.88];
  const min=[6.33,2.68,3.52,5.38,2.60,3.53,2.54,4.75,3.98,2.69,3.34,3.17];
  let best='—',bs=-1;
  for(let r=0;r<12;r++){
    for(const [prof,suf] of [[maj,''],[min,'m']]){
      let dot=0; for(let i=0;i<12;i++) dot+=total[(i+r)%12]*prof[i];
      if(dot>bs){bs=dot;best=NAMES[r]+suf;}
    }
  }
  return best;
}

function isMinor(lbl){return lbl.endsWith('m');}
function fmt(t){const m=Math.floor(t/60),s=Math.floor(t%60);return m+':'+String(s).padStart(2,'0');}

function render(segs,bpm,keyLabel,duration){
  document.getElementById('bpm').innerHTML = (bpm||'—')+'<small>BPM</small>';
  document.getElementById('key').textContent = keyLabel;
  document.getElementById('dur').innerHTML = Math.round(duration)+'<small>сек</small>';

  // таймлайн
  const tl=document.getElementById('timeline'); tl.innerHTML='';
  if(!segs.length){tl.innerHTML='<div style="color:var(--muted);margin:auto;font-family:IBM Plex Mono,monospace;font-size:13px">Аккорды не распознаны — попробуй запись почище</div>';}
  segs.forEach(s=>{
    const el=document.createElement('div');
    el.className='seg '+(isMinor(s.label)?'min':'maj');
    el.style.flex=(s.end-s.start)+' 0 0';
    el.textContent=s.label; el.title=s.label+'  '+fmt(s.start)+'–'+fmt(s.end);
    tl.appendChild(el);
  });

  // таблица
  const tb=document.getElementById('tablebody'); tb.innerHTML='';
  segs.forEach(s=>{
    const tr=document.createElement('tr');
    tr.innerHTML='<td>'+fmt(s.start)+'</td><td><span class="pill '+
      (isMinor(s.label)?'min':'maj')+'">'+s.label+'</span></td>';
    tb.appendChild(tr);
  });

  // бой по темпу
  const sp=document.getElementById('strumpattern'), sn=document.getElementById('strumnote');
  if(!bpm){sp.textContent='—';sn.textContent='Не удалось определить темп.';}
  else if(bpm<80){sp.textContent='↓   ↓↑  ↑↓↑';sn.textContent='Медленный темп — плавная «шестёрка», хорошо для баллад.';}
  else if(bpm<120){sp.textContent='↓  ↓  ↑  ↑↓↑';sn.textContent='Средний темп — универсальная «четвёрка».';}
  else{sp.textContent='↓↑ ↓↑ ↓↑ ↓↑';sn.textContent='Быстрый темп — ровная «восьмёрка».';}

  statusEl.classList.remove('on');
  resultsEl.classList.add('on');
  resultsEl.scrollIntoView({behavior:'smooth',block:'start'});
}
</script>
</body>
</html>
